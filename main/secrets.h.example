#pragma once

/* ─────────────────────────────────────────────────────────────
 * Las credenciales WiFi se configuran EXCLUSIVAMENTE por el portal
 * cautivo y se guardan en NVS. El equipo arranca sin credenciales:
 *   - Sin redes guardadas  → entra al portal automáticamente.
 *   - Botón externo (GPIO2) presionado al arranque → borra y portal.
 *   - Botón BOOT mantenido 3 s en operación → borra y reinicia al portal.
 * No hace falta reflashear ni editar este archivo para cambiar de red.
 * ───────────────────────────────────────────────────────────── */

/* AWS IoT Core — valores por defecto (semilla). Editables en campo
 * desde el portal cautivo (sección "Ajustes avanzados").
 * Endpoint: aws iot describe-endpoint --endpoint-type iot:Data-ATS  */
#define AWS_IOT_ENDPOINT  "xxxxxxxxxxxxx-ats.iot.us-east-2.amazonaws.com"
#define AWS_THING_NAME    "tu_objeto_iot"
